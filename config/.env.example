# 工艺单自动上传 Skill — 配置文件模板
# 复制此文件为 .env，首次运行时会自动引导填写身份信息

# ========== 沙箱环境 ==========
MC_API_BASE_URL=https://mctwo.fsjqfz.xyz/makeCloth
MC_WEB_BASE_URL=https://mctwo.fsjqfz.xyz
MC_USERNAME=
MC_PASSWORD=
MC_LOGIN_TYPE=erp-pc

# ========== API 路径 ==========
MC_IMAGE_UPLOAD_URL=/business/upload/img
MC_DESIGN_INSERT_URL=/business/design/insertDesign
MC_CUSTOMER_LIST_URL=/business/customer/public
MC_DESIGNER_LIST_URL=/dept/getUserList/name

# ========== 使用者身份（首次运行自动收集，无需手动填写）==========
# 真实姓名
MC_USER_REALNAME=
# 系统内设计师ID（从 /dept/getUserList/name 自动查询）
MC_USER_DESIGNER_ID=
